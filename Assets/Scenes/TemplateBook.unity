  m_Script: {fileID: 11500000, guid: ce7fc8da2221e434c84814d022392aae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localization: {fileID: 11400000, guid: 1f3b411703555425d863c3f14c178acd, type: 2}
  textType: 1
  texts:
  - language: EN
    text: 
  - language: TR
    text: "\xC7ok merak etti\u011Fim bir \u015Fey var: Aran\u0131zda kitap kurdunun\nne
      oldu\u011Funu bilen var m\u0131? Annemin dedi\u011Fine g\xF6re\n\xE7ooook kitap
      okursam kitap kurdu olabilirmi\u015Fim. Elma\nkurdu, elman\u0131n i\xE7inde
      ya\u015Far. Bir s\xFCr\xFC delik a\xE7\u0131p yuvas\u0131n\u0131\nkurar. Peki
      ya kitap kurdu? Kitaplar\u0131n i\xE7inde mi ya\u015Far?\nBen de kitaplar\u0131n
      i\xE7inde mi ya\u015Fayaca\u011F\u0131m?"
