  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ben okuldayken? G\xFCne\u015F batarken? Uyudumdan hemen\n\xF6nce? Ay do\u011Fdu\u011Funda?
    Y\u0131ld\u0131z kayd\u0131\u011F\u0131nda? Bisiklete\nbinerken? Y\xFCzme yar\u0131\u015F\u0131
    yaparken? Do\u011Fum g\xFCnlerinde?\nAkl\u0131ma bir s\xFCr\xFC \u015Fey geliyordu.
    Bir sabah uyand\u0131\u011F\u0131mda\nonlar\u0131 evde g\xF6remezsem ya da onlardan
    \xF6nce bir kurda\nd\xF6n\xFC\u015F\xFCrsem ne yapard\u0131m?"
