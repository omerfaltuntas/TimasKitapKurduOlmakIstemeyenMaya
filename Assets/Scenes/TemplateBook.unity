  m_EditorClassIdentifier: 
  localization: {fileID: 11400000, guid: 1f3b411703555425d863c3f14c178acd, type: 2}
  textType: 1
  texts:
  - language: EN
    text: 
  - language: TR
    text: "Merhaba, benim ad\u0131m Maya. \xC7ok merak etti\u011Fim bir \u015Fey
      var.\nAran\u0131zda kitap kurdunun ne oldu\u011Funu bilen var m\u0131?\nAnnemin
      dedi\u011Fine g\xF6re \xE7ooook kitap okursam kitap kurdu olabilirmi\u015Fim.\nFakat
      akl\u0131ma tak\u0131lan bir soru var:\nKitap kurdu kitaplar\u0131n i\xE7inde
      mi ya\u015Far?\nKitaplar\u0131n i\xE7inde ya\u015Fayan bir kurt olmak istemiyorum!"
